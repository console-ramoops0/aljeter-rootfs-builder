# Aljeter (Moto G6 Play - MSM8937) Mainline Linux configuration fragment

# Core SoC & Architecture (Qualcomm MSM8937 / MSM8917 / MSM8920)
CONFIG_ARCH_QCOM=y
CONFIG_MSM_GCC_8917=y
CONFIG_PINCTRL_MSM8917=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_MSM8937=y
CONFIG_INTERCONNECT_QCOM_SMD_RPM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SPMI=y

# Display & Early Boot Framebuffer (DRM simple-framebuffer + KMS)
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_MOTOROLA_MOT=y
CONFIG_DRM_PANEL_MSM89X7_GENERATED=y
CONFIG_DRM_PANEL_MOTOROLA_JETER_570_DJN=y
CONFIG_DRM_PANEL_MOTOROLA_JETER_570_TIANMA=y
CONFIG_DRM_PANEL_MOTOROLA_JETER_570_WISTRON=y
CONFIG_DRM_PANEL_MOTOROLA_JETER_571_DJN=y
CONFIG_DRM_PANEL_MOTOROLA_JETER_571_TIANMA=y
CONFIG_BACKLIGHT_QCOM_WLED=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# USB & SSH Gadget networking (Built-in ChipIdea UDC + 28nm Femto PHY)
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_CHIPIDEA_MSM=y
CONFIG_PHY_QCOM_USB_HS_28NM=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_F_NCM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_FS=y
CONFIG_EXTCON=y
CONFIG_EXTCON_USB_GPIO=y
CONFIG_EXTCON_QCOM_SPMI_MISC=y

# Wireless & Connectivity (WCNSS + WCN3620)
CONFIG_QCOM_WCNSS=m
CONFIG_QCOM_WCNSS_PIL=m
CONFIG_QCOM_WCNSS_CTRL=m
CONFIG_RPMSG_QCOM_WCNSS=m
CONFIG_WCN36XX=m
CONFIG_WCN36XX_SNAPDRAGON=y
CONFIG_BT_QCOMSMD=m

# Input & Touchscreen
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_NT36672A=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y

# Storage & Partitions
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EXT4_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y

# Power, PMIC, Battery & Thermal
CONFIG_BATTERY_PMI8950_FG=y
CONFIG_CHARGER_PMI8950=y
CONFIG_POWER_RESET_MSM=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_QCOM_WDT=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_RPM_PROC=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_TSENS=y

# Pstore / Ramoops
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Size optimization for 16MB boot partition: trim non-Qualcomm architectures
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
