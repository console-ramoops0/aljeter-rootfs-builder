# Aljeter (Moto G6 Play) Mainline Linux configuration fragment

# Display & Early Boot Framebuffer
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_MSM=y

# Jeter/Aljeter Panels (Tianma, DJN, Wistron)
CONFIG_PANEL_MOTOROLA_JETER_570_TIANMA=y
CONFIG_PANEL_MOTOROLA_JETER_570_DJN=y
CONFIG_PANEL_MOTOROLA_JETER_570_WISTRON=y
CONFIG_PANEL_MOTOROLA_JETER_571_TIANMA=y
CONFIG_PANEL_MOTOROLA_JETER_571_DJN=y
CONFIG_BACKLIGHT_QCOM_WLED=y

# USB & SSH Gadget networking
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_CHIPIDEA_MSM=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_F_FS=y

# Wireless & Connectivity (WCN3620)
CONFIG_WCN36XX=m
CONFIG_WCN36XX_SNAPDRAGON=y
CONFIG_BT_QCOMSMD=m

# Input & Touchscreen
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_NT36672A=m
CONFIG_KEYBOARD_GPIO=y

# Storage & Power
CONFIG_MMC_SDHCI_MSM=y
CONFIG_BATTERY_PMI8950_FG=y
CONFIG_CHARGER_PMI8950=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_RPM_PROC=y

# Pstore / Ramoops
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
