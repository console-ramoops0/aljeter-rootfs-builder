#!/bin/sh
set -eu

# Automatically grow the ext4 filesystem to fill the partition (eMMC userdata or SD card)
DEV=""
root_source="$(findmnt -no SOURCE / 2>/dev/null || true)"

case "$root_source" in
    /dev/mmcblk*|/dev/sd*|/dev/disk/by-*/*)
        DEV="$(readlink -f "$root_source" 2>/dev/null || echo "$root_source")"
        ;;
    *)
        MAJMIN="$(findmnt -no MAJ:MIN / 2>/dev/null | tr -d ' ' || true)"
        if [ -n "$MAJMIN" ] && [ -d "/sys/dev/block/$MAJMIN" ]; then
            DEV="/dev/$(basename "$(readlink -f "/sys/dev/block/$MAJMIN")")"
        fi
        ;;
esac

if [ -n "$DEV" ] && [ -b "$DEV" ]; then
    echo "Expanding root filesystem on $DEV..."
    resize2fs "$DEV" || true
fi
